<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>MarketingAutomation</AssemblyName>
        <Product>MarketingAutomation</Product>
        <Version>1.0.0</Version>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
        
        <RepositoryRoot>$(MSBuildProjectDirectory)/../..</RepositoryRoot>
        <LibDirectory>$(RepositoryRoot)/lib</LibDirectory>
        
        <DeployToGame>true</DeployToGame>
    </PropertyGroup>

    <!-- Global using -->
    <ItemGroup>
        <Using Include="System" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.Core" Version="5.*"/>
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.2" IncludeAssets="compile"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(LibDirectory)/Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath>$(LibDirectory)/Assembly-CSharp-firstpass.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(LibDirectory)/UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="DeployPlugin" AfterTargets="Build"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(DeployToGame)' == 'true'">
        <Error Condition="!Exists('$(RepositoryRoot)/.config.local')"
               Text="Local configuration is missing. Run initialize.ps1 (Windows) or bash initialize.sh (Linux/macOS), or build with -p:DeployToGame=false."/>
        
        <Exec Condition="Exists('$(RepositoryRoot)/.config.local') and '$(OS)' == 'Windows_NT'"
              WorkingDirectory="$(RepositoryRoot)"
              EnvironmentVariables="MOD_ASSEMBLY=$(TargetPath)"
              Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/deploy.ps1"/>
        
        <Exec Condition="Exists('$(RepositoryRoot)/.config.local') and '$(OS)' != 'Windows_NT'"
              WorkingDirectory="$(RepositoryRoot)"
              EnvironmentVariables="MOD_ASSEMBLY=$(TargetPath)"
              Command="bash scripts/deploy.sh"/>
    </Target>
</Project>
